# Copy to .env and fill in:   cp .env.example .env
# Used by docker-compose.yml (self-hosting). Railway doesn't read this file.
# Guide: docs/self-hosting.md

# --- Which HTTPS front to run (pick one) -----------------------------------
#   tunnel   Cloudflare Tunnel: home PC, needs a domain on Cloudflare
#   caddy    Caddy on ports 80/443: a server with its own public IPv4
COMPOSE_PROFILES=tunnel

# --- Required ----------------------------------------------------------------

# Web UI / native API password (user "opencode"). Long and random:
#   openssl rand -base64 32
OPENCODE_SERVER_PASSWORD=

# Profile "tunnel" only: the token from Cloudflare Zero Trust -> Networks ->
# Tunnels -> your tunnel (the long string after --token in the install command).
CLOUDFLARE_TUNNEL_TOKEN=

# Profile "caddy" only: hostname Caddy serves and gets a certificate for.
#   Your own domain (DNS A record -> server IP):  opencode.example.com
#   No domain: server's public IPv4 + .sslip.io:   203.0.113.7.sslip.io
SITE_ADDRESS=

# --- Recommended ---------------------------------------------------------------

# Separate Bearer key for /v1 clients, so they can't log in to the web UI.
# Empty = /v1 accepts OPENCODE_SERVER_PASSWORD.
OPENAI_COMPAT_API_KEY=

# --- Optional (defaults shown; see README section 4) ---------------------------
# OPENCODE_SERVER_USERNAME=opencode
# OPENAI_COMPAT_ENABLED=true
# OPENAI_COMPAT_AGENT=
# OPENAI_COMPAT_DIRECTORY=/data/workspace
# OPENAI_COMPAT_TIMEOUT_SECONDS=600
# OPENAI_COMPAT_KEEP_SESSIONS=
# OPENAI_COMPAT_MAX_RETRY_WAIT_SECONDS=30
# OPENAI_COMPAT_MAX_BODY_MB=25
# OPENAI_COMPAT_MAX_IMAGE_MB=10
